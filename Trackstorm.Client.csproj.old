<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Trackstorm.Client</AssemblyName>
    <RootNamespace>Trackstorm.Client</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="code/Core/**/*.cs" />
    <Compile Remove="code/Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="code/Core/Trackstorm.Core.csproj" />
  </ItemGroup>
</Project>
