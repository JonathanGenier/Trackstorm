root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

# Non-blocking editor preferences.
dotnet_style_namespace_declarations = file_scoped:suggestion
dotnet_style_qualification_for_namespace = false:suggestion

[*.{csproj,props,sln,tscn,godot,yml,yaml,md,ps1}]
indent_style = space
indent_size = 2

# Vendored dependencies retain their upstream source policy.
[addons/gdUnit4/**/*.cs]
generated_code = true

# Official EOS SDK source is acquired unchanged.
[.godot/eos-sdk/**/*.cs]
generated_code = true
