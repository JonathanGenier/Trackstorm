<Project>
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers"
                      Version="1.2.0-beta.556"
                      PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TrackstormVersion>0.1.8</TrackstormVersion>
    <Version>$(TrackstormVersion)</Version>
    <AssemblyVersion>$(TrackstormVersion).0</AssemblyVersion>
    <FileVersion>$(TrackstormVersion).0</FileVersion>
    <InformationalVersion>$(TrackstormVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="TrackstormVersion" Value="$(TrackstormVersion)" />
  </ItemGroup>
</Project>
