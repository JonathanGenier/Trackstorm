# Normalize line endings for all files Git considers text.
* text=auto eol=lf

# Preserve verbatim upstream license bytes and their recorded source checksums.
assets/arena/kenney/**/License.txt -text -whitespace
assets/items/kenney/**/License.txt -text -whitespace
assets/vehicles/kenney/License.txt -text -whitespace

# Preserve the approved TS-85 source and runtime video without GitHub's ordinary blob-size limit.
*.mov filter=lfs diff=lfs merge=lfs -text
*.ogv filter=lfs diff=lfs merge=lfs -text
